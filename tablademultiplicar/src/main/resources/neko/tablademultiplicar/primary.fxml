<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="neko.tablademultiplicar.controladordelatabla">
   <children>

      <Label layoutX="30.0" layoutY="30.0" text="Tabla del:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtNumero" layoutX="30.0" layoutY="60.0" prefHeight="30.0" prefWidth="60.0">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>

      <Button fx:id="btnCalcular" layoutX="200.0" layoutY="30.0" mnemonicParsing="false" onAction="#handleCalcular" prefHeight="30.0" prefWidth="100.0" text="Calcular" />
      <Button fx:id="btnLimpiar" layoutX="200.0" layoutY="75.0" mnemonicParsing="false" onAction="#handleLimpiar" prefHeight="30.0" prefWidth="100.0" text="Limpiar" />

   
      <TextArea fx:id="txtAreaTabla" editable="false" layoutX="30.0" layoutY="130.0" prefHeight="230.0" prefWidth="270.0">
         <font>
            <Font size="14.0" />
         </font>
      </TextArea>
   </children>
</AnchorPane>