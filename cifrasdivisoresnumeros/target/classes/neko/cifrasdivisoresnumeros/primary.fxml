<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="neko.cifrasdivisoresnumeros.controladordecifras">
   <children>
      <Label layoutX="25.0" layoutY="20.0" text="Cifras y Divisores de un Número">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>

      <Label layoutX="25.0" layoutY="80.0" text="Ingrese un número" />
      <TextField fx:id="txtNumero" layoutX="140.0" layoutY="76.0" prefWidth="150.0" />
      <Button fx:id="btnAnalizar" layoutX="320.0" layoutY="76.0" mnemonicParsing="false" onAction="#handleAnalizar" text="Analizar" />
      <Button fx:id="btnLimpiar" layoutX="400.0" layoutY="76.0" mnemonicParsing="false" onAction="#handleLimpiar" text="Limpiar" />

      <Label layoutX="25.0" layoutY="150.0" text="Cantidad de cifras" />
      <TextField fx:id="txtCantCifras" editable="false" layoutX="175.0" layoutY="146.0" prefWidth="115.0" />

      <Label layoutX="25.0" layoutY="190.0" text="Suma de cifras impares" />
      <TextField fx:id="txtSumaImpares" editable="false" layoutX="175.0" layoutY="186.0" prefWidth="115.0" />

      <Label layoutX="25.0" layoutY="230.0" text="Suma de cifras pares" />
      <TextField fx:id="txtSumaPares" editable="false" layoutX="175.0" layoutY="226.0" prefWidth="115.0" />

      <Label layoutX="25.0" layoutY="270.0" text="Suma total de cifras" />
      <TextField fx:id="txtSumaTotal" editable="false" layoutX="175.0" layoutY="266.0" prefWidth="115.0" />

      <Label layoutX="25.0" layoutY="310.0" text="Cifra mayor" />
      <TextField fx:id="txtCifraMayor" editable="false" layoutX="175.0" layoutY="306.0" prefWidth="115.0" />

      <Label layoutX="25.0" layoutY="350.0" text="Cifra menor" />
      <TextField fx:id="txtCifraMenor" editable="false" layoutX="175.0" layoutY="346.0" prefWidth="115.0" />

      <Label layoutX="330.0" layoutY="150.0" text="Divisores" />
      <TextArea fx:id="txtAreaDivisores" editable="false" layoutX="330.0" layoutY="175.0" prefHeight="210.0" prefWidth="280.0" />
   </children>
</AnchorPane>