<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="350.0" prefWidth="540.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="neko.controldegastos.controladordegastos">
   <children>

       <Label layoutX="25.0" layoutY="20.0" text="Control de Gastos Semanales">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>

      <Label layoutX="25.0" layoutY="70.0" text="Alimentación:" />
      <TextField fx:id="txtAlimentacion" layoutX="120.0" layoutY="66.0" prefWidth="110.0" />

      <Label layoutX="25.0" layoutY="110.0" text="Refrigerios:" />
      <TextField fx:id="txtRefrigerios" layoutX="120.0" layoutY="106.0" prefWidth="110.0" />

      <Label layoutX="25.0" layoutY="150.0" text="Transporte:" />
      <TextField fx:id="txtTransporte" layoutX="120.0" layoutY="146.0" prefWidth="110.0" />

      <Label layoutX="25.0" layoutY="190.0" text="Telefonía:" />
      <TextField fx:id="txtTelefonia" layoutX="120.0" layoutY="186.0" prefWidth="110.0" />

      <Label layoutX="25.0" layoutY="230.0" text="Otros:" />
      <TextField fx:id="txtOtros" layoutX="120.0" layoutY="226.0" prefWidth="110.0" />

      <Label layoutX="300.0" layoutY="70.0" text="Estadísticas">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

      <Label layoutX="300.0" layoutY="110.0" text="Total semanal:" />
      <TextField fx:id="txtTotal" editable="false" layoutX="300.0" layoutY="135.0" prefWidth="180.0" />

      <Label layoutX="300.0" layoutY="180.0" text="Gasto más alto:" />
      <TextField fx:id="txtMayor" editable="false" layoutX="300.0" layoutY="205.0" prefWidth="180.0" />

      
      <Button fx:id="btnCalcular" layoutX="25.0" layoutY="280.0" mnemonicParsing="false" onAction="#handleCalcular" prefHeight="35.0" prefWidth="110.0" text="Calcular" textAlignment="CENTER" wrapText="true" />
      <Button fx:id="btnLimpiar" layoutX="150.0" layoutY="280.0" mnemonicParsing="false" onAction="#handleLimpiar" prefHeight="35.0" prefWidth="90.0" text="Limpiar" />
   </children>
</AnchorPane>